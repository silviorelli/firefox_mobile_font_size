{
  "manifest_version": 3,
  "name": "Page Font Size",
  "version": "1.0.0",
  "description": "Zoom web pages in and out per site, the Ctrl+ / Ctrl- that Firefox for Android never had.",
  "browser_specific_settings": {
    "gecko": {
      "id": "page-font-size@relli.it",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Page Font Size",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["zoom-levels.js", "overlay.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
