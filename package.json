{
  "name": "firefox-mobile-font-size",
  "version": "1.2.0",
  "description": "Per-site page zoom for Firefox for Android, the Ctrl+/Ctrl- that mobile Firefox never had.",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "web-ext lint --source-dir=src --warnings-as-errors",
    "start:desktop": "web-ext run --source-dir=src --devtools",
    "start:android": "web-ext run --source-dir=src --target=firefox-android --firefox-apk=org.mozilla.firefox",
    "build": "web-ext build --source-dir=src --overwrite-dest",
    "icons": "node tools/make-icons.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "web-ext": "^10.6.0"
  }
}
